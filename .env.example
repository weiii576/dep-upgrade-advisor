# Copy to .env and fill in. .env is gitignored.

# Local Postgres with pgvector. The Makefile composes the connection URL from these four parts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dua

# Anthropic (needed from A1, 10/22)
ANTHROPIC_API_KEY=

# LangSmith tracing (needed from A11, W6; set TRACING=false until then)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dep-upgrade-advisor
